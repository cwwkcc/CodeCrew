### Problem 5: Reverse Words in String

```cpp
#include <sstream>
#include <vector>

string reverseWords(string str) {
    stringstream ss(str);
    vector<string> words;
    string word;
    
    // Extract words
    while (ss >> word) {
        words.push_back(word);
    }
    
    // Reverse words vector
    reverse(words.begin(), words.end());
    
    // Combine back
    string result = "";
    for (int i = 0; i < words.size(); i++) {
        result += words[i];
        if (i < words.size() - 1) {
            result += " ";
        }
    }
    
    return result;
}

