    cin >> year;
    
    // Leap year rules:
    // 1. Divisible by 4
    // 2. If divisible by 100, must also be divisible by 400
    
    if (year % 4 == 0) {
        if (year % 100 == 0) {
            // Century year - must be divisible by 400
