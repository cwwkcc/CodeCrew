### Complete Example

```cpp
template<typename T>
class Calculator {
public:
    T add(T a, T b);
    T subtract(T a, T b);
    T multiply(T a, T b);
    T divide(T a, T b);
};

// Define member functions outside class
template<typename T>
T Calculator<T>::add(T a, T b) {
    return a + b;
}

