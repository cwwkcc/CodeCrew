### Handling Conversion Errors

```cpp
#include <iostream>
#include <string>
using namespace std;

int main() {
    string input;
    
    cout << "Enter your age: ";
    getline(cin, input);
    
    try {
        int age = stoi(input);
        
        if (age < 0 || age > 120) {
