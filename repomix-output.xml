    if (isLeapYear) {
        cout << year << " is a leap year!" << endl;
        cout << "February has 29 days." << endl;
    } else {
        cout << year << " is NOT a leap year." << endl;
        cout << "February has 28 days." << endl;
    }
    
    return 0;
}
