## Use const Liberally

```cpp
// Prevents accidental modification
void processData(const vector<int>& data) {
    // data.push_back(5);  // Compile error!
    // Good - caught at compile time
}

// Const member functions
class BankAccount {
public:
    double getBalance() const {
        // balance++;  // Compile error!
        return balance;
    }
};
```

