    case 3:
    case 4:
    case 5:
        cout << "Season: Spring" << endl;
        break;
    
    case 6:
    case 7:
    case 8:
        cout << "Season: Summer" << endl;
        break;
    
    case 9:
    case 10:
    case 11:
        cout << "Season: Fall" << endl;
        break;
    
    default:
        cout << "Invalid month!" << endl;
        break;
}
```

