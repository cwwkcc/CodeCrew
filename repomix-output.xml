        if (a > 0 && a < 100) {
            age = a;
        }
    }
    
    void setGPA(double g) {
        if (g >= 0.0 && g <= 4.0) {
            gpa = g;
        }
    }
    
    // Getters
    int getID() { return id; }
    string getName() { return name; }
    int getAge() { return age; }
    double getGPA() { return gpa; }
    
    // Member functions
    void display() {
        cout << "\n=== Student Information ===" << endl;
        cout << "ID: " << id << endl;
        cout << "Name: " << name << endl;
        cout << "Age: " << age << endl;
        cout << "GPA: " << gpa << endl;
    }
    
    char getGrade() {
        if (gpa >= 3.7) return 'A';
        else if (gpa >= 3.0) return 'B';
        else if (gpa >= 2.0) return 'C';
        else if (gpa >= 1.0) return 'D';
        else return 'F';
    }
    
    bool isPassing() {
        return gpa >= 2.0;
    }
};

int main() {
    // Create students
    Student s1(101, "Alice Johnson", 20, 3.8);
